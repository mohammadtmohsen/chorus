{
  "name": "chorus",
  "version": "0.19.6",
  "private": true,
  "type": "module",
  "description": "A local-first workspace for collaborating with multiple coding agents in one shared conversation.",
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "node scripts/fix-spawn-helper.mjs",
    "dev": "node scripts/fix-spawn-helper.mjs && pnpm --filter @chorus/desktop dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "errors": "turbo run typecheck",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test",
    "clean": "turbo run clean && node scripts/rm.mjs node_modules",
    "e2e": "pnpm --filter @chorus/desktop run build && pnpm --filter @chorus/desktop run e2e",
    "package": "pnpm run build && pnpm --filter chorus-vscode run package && pnpm --filter @chorus/desktop run package",
    "app:install": "pnpm --filter @chorus/desktop run app:install",
    "verify:package": "pnpm package && pnpm --filter @chorus/desktop run verify:package",
    "verify:package:windows": "pnpm package && pnpm --filter @chorus/desktop run verify:package:windows"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.18.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "turbo": "^2.10.8",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
