{
  "name": "@chorus/orchestrator",
  "version": "0.0.0",
  "private": true,
  "description": "Domain core: conversation, handoff, policy, approvals. Zero Electron, zero adapters.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "node ../../scripts/rm.mjs dist *.tsbuildinfo"
  },
  "dependencies": {
    "@chorus/agent-protocol": "workspace:*",
    "@chorus/event-store": "workspace:*",
    "@chorus/shared": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "better-sqlite3": "^13.0.2"
  }
}
