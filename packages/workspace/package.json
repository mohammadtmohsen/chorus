{
  "name": "@chorus/workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Project roots, git status and diffs, worktrees, and path safety.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./diff": {
      "types": "./dist/diff.d.ts",
      "default": "./dist/diff.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "node ../../scripts/rm.mjs dist *.tsbuildinfo"
  },
  "dependencies": {
    "@chorus/ide-protocol": "workspace:*",
    "@chorus/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1"
  }
}
