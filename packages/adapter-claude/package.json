{
  "name": "@chorus/adapter-claude",
  "version": "0.0.0",
  "private": true,
  "description": "AgentAdapter over @anthropic-ai/claude-agent-sdk, driving the installed CLI.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "node ../../scripts/rm.mjs dist *.tsbuildinfo"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@chorus/agent-protocol": "workspace:*",
    "@chorus/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1"
  }
}
