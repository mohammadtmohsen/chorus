{
  "name": "chorus-vscode",
  "displayName": "Chorus",
  "description": "Lets Chorus see the file and lines you have selected, for the project it already has open.",
  "version": "0.9.0",
  "private": true,
  "publisher": "chorus",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%chorus.trust.description%"
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "chorus.reconnect",
        "title": "%chorus.command.reconnect%",
        "category": "Chorus"
      },
      {
        "command": "chorus.diagnose",
        "title": "%chorus.command.diagnose%",
        "category": "Chorus"
      },
      {
        "command": "chorus.sendDiagnostic",
        "title": "%chorus.command.sendDiagnostic%",
        "category": "Chorus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "chorus.sendDiagnostic",
          "when": "editorTextFocus",
          "group": "9_cutcopypaste@100"
        }
      ]
    },
    "configuration": {
      "title": "Chorus",
      "properties": {
        "chorus.trace": {
          "type": "boolean",
          "default": false,
          "description": "%chorus.config.trace%"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.mts",
    "clean": "node ../../scripts/rm.mjs dist *.tsbuildinfo",
    "package": "node package.mjs"
  },
  "dependencies": {
    "@chorus/ide-protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/vscode": "^1.94.0",
    "esbuild": "^0.25.0"
  }
}
