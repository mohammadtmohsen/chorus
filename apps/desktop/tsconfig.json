{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false
  },
  "include": [
    "src/**/*",
    "electron.vite.config.ts",
    "vitest.config.mts",
    // `profile/` is outside the fast suite's include glob on purpose — it opens
    // a 272 MB fixture — but it is still code, and typecheck and lint have to
    // see it or a measurement rots silently while `pnpm check` stays green.
    "profile/**/*",
    "vitest.profile.mts"
  ]
}
