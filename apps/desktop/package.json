{
  "name": "@chorus/desktop",
  "version": "0.19.5",
  "private": true,
  "description": "Work with several coding agents in one conversation, on your own machine.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node ../../scripts/without-env.mjs ELECTRON_RUN_AS_NODE -- electron-vite dev",
    "build": "electron-vite build",
    "preview": "node ../../scripts/without-env.mjs ELECTRON_RUN_AS_NODE -- electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.mts",
    "clean": "node ../../scripts/rm.mjs out dist *.tsbuildinfo",
    "e2e": "node e2e/run.mjs",
    "icon": "node build/make-icon.mjs",
    "package": "electron-vite build && electron-builder --config electron-builder.yml",
    "package:dir": "electron-vite build && electron-builder --config electron-builder.yml --dir",
    "app:install": "pnpm run package:dir && node build/install-local.mjs",
    "verify:package": "node e2e/packaged.mjs",
    "verify:package:windows": "node e2e/packaged-windows.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@chorus/adapter-claude": "workspace:*",
    "@chorus/adapter-codex": "workspace:*",
    "@chorus/agent-protocol": "workspace:*",
    "@chorus/event-store": "workspace:*",
    "@chorus/ide-protocol": "workspace:*",
    "@chorus/orchestrator": "workspace:*",
    "@chorus/shared": "workspace:*",
    "@chorus/workspace": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "6.1.0-beta.302",
    "better-sqlite3": "^13.0.2",
    "i18next": "^26.3.6",
    "node-pty": "^1.1.0",
    "react-i18next": "^17.0.11",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^8.2.0"
  },
  "author": "Chorus"
}
