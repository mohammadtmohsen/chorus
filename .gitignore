node_modules/
dist/
out/
build/
# …except electron-builder's buildResources, which is source, not output.
!apps/desktop/build/
!apps/extension/build/
.turbo/
coverage/
*.tsbuildinfo

# Electron packaging output
apps/desktop/out/
apps/desktop/dist/
# Built apps and DMGs — attached to a GitHub release, never committed.
apps/desktop/release/
# The remote extension host, staged into the bundle by `build/stage-reh.cjs`.
# 76 MB of third-party archive, re-fetchable and checksum-addressed, and it sits
# under `apps/desktop/build/` which the rule above deliberately un-ignores.
apps/desktop/build/reh/

# Generated Codex protocol bindings are committed on purpose (see plan §6.1).
# Nothing else generated should be.

# Local data
*.db
*.db-shm
*.db-wal
.chorus/

# Environment / secrets — never commit
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

*.vsix

# The workbench REH download cache. A 76 MB checksum-addressed artifact fetched
# from a VSCodium release, verified against apps/desktop/build/workbench-runtime.json
# before it is unpacked — recoverable at any time, so it is never committed.
.workbench-cache/

# The fixture extension's packaged VSIX. Built by `apps/workbench-fixture/package.mjs`
# from the four files beside it, so it is reproducible and never committed — the
# same rule the REH cache above follows.
apps/workbench-fixture/*.vsix
